# Postgres (used by docker-compose.yml)
POSTGRES_USER=whisky
POSTGRES_PASSWORD=whisky
POSTGRES_DB=whiskyindex
POSTGRES_PORT=5432

# Production Postgres — used only by `npm run db:seed:prod`.
# `npm run db:seed` always targets the local Docker db.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
