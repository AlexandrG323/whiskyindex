{
  "name": "whiskyindex-backend",
  "version": "0.1.0",
  "description": "Whisky Index API — цены продуктов из БД + данные об акциях",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
