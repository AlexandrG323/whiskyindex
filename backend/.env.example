# Server
PORT=3000

# Database
DATABASE_URL=postgresql://whisky:whisky@localhost:5432/whiskyindex

# Stock import (домашка) — базовые URL, ключи обычно не нужны
# MOEX ISS: https://iss.moex.com
# Yahoo chart: https://query1.finance.yahoo.com
MOEX_ISS_BASE_URL=https://iss.moex.com
YAHOO_CHART_BASE_URL=https://query1.finance.yahoo.com

# Опционально: сузить период импорта при отладке
# STOCK_IMPORT_FROM_YEAR=2007
# STOCK_IMPORT_TO_YEAR=2026

# Free-form ticker lookup (диалог «Описание»)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
