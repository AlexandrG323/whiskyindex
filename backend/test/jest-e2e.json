{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "target": "ES2021",
          "emitDecoratorMetadata": true,
          "experimentalDecorators": true,
          "esModuleInterop": true,
          "strictNullChecks": true,
          "skipLibCheck": true
        }
      }
    ]
  }
}
